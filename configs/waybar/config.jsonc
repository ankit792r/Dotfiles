{
  "layer":"top",
  "position": "top",
  "height": 28,
  "modules-left": [
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [],
  "modules-right": [
    "pulseaudio",
    "backlight",
    "disk#root",
    "network",
    "bluetooth",
    "cpu",
    "memory",
    "temperature",
    "battery",
    "clock",
    "tray"
  ],

  "clock": {
    "timezone": "Asia/Kolkata",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%Y-%m-%d}"
  },

  "cpu": {
    "format": "  {usage}%",
    "tooltip": false
  },

  "memory": {
    "format": "  {used:0.2f}GiB"
  },

  "disk#root": {
    "interval": 60,
    "format": "  {percentage_used}%",
    "path": "/"
  },

  // "disk#home": {
  //   "interval": 30,
  //   "format": "{percentage_used}%/{total}",
  //   "path": "/home"
  // },

  "temperature": {
    "critical-threshold": 80,
    "format": " {temperatureC}°C"
   },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 20
    },
    "format": "󰁹 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-charging": "󰁹 {capacity}%",
    "format-plugged": "󰁹 {capacity}%"
  },

  "network": {
    "format-wifi": "󰤥  {essid}",
    "format-ethernet": "󰈀  {ipaddr}/{cidr}",
    "tooltip-format": "{ifname} via {gwaddr}",
    "format-linked": "{ifname} (No IP)",
    "format-disconnected": "WiFi Disconnected",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "wlctl"
  },

  "bluetooth": {
    "format": " {status}",
    "format-disabled": " OFF",
    "format-connected": " {device_alias}",
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "on-click": "bluetui"
  },

  "pulseaudio": {
    "format": "󰓃 {volume}%",
    "format-bluetooth": "󰦢  {volume}%",
    "format-muted": "󰓄 MUTED",
    "format-source": "{volume}%",
    "format-source-muted": "MUTED",
    "on-click": "pavucontrol"
  },

  "backlight": {
    "format": "󰃠  {percent}%"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 5
  }
}

