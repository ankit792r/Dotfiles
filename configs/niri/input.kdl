input {
  keyboard {
    xkb {
      // layout "us"
      // variant ""
      // options "caps:escape"
    }

    repeat-delay 200
    repeat-rate 40
    // numlock
  }

  touchpad {
    tap
    natural-scroll
    accel-profile "flat"
  }

  mouse {
    accel-profile "flat"
    accel-speed 0.1
    scroll-factor 1.4
  }

  focus-follows-mouse max-scroll-amount="15%"
  warp-mouse-to-focus
}

cursor {
  xcursor-theme "Qogir-cursors"
  xcursor-size 28
  hide-when-typing
  hide-after-inactive-ms 2500
}
