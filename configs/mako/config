# Font
font=Iosevka Nerd Font 12

# General layout
width=480
height=120
margin=4
padding=6
border-size=2
border-radius=0
layer=top
anchor=top-center

# Vague-inspired palette
background-color=#141415f2
text-color=#cdcdcd
border-color=#3a3a46

# Icons
icons=1
icon-path=/usr/share/icons
max-icon-size=42

# Behavior
default-timeout=5000
ignore-timeout=0
group-by=app-name

# Progress bar
progress-color=#4c4c5c

# --- Urgency styling ---

[urgency=low]
background-color=#141415f2
text-color=#777783
border-color=#303038

[urgency=normal]
background-color=#141415f2
text-color=#cdcdcd
border-color=#3a3a46

[urgency=high]
background-color=#191416f2
text-color=#d7a0a0
border-color=#b86f78
