* {
    /* Vague-inspired palette */
    active:   #3a3a46;
    inactive: #303038;

    bg:       rgba(20, 20, 21, 0.96);
    bg-alt:   rgba(25, 25, 27, 0.96);

    fg:       #cdcdcd;
    fg-alt:   #777783;

    selected-bg: #4c4c5c;

    background-color: transparent;
    text-color: @fg;

    font-family: "Iosevka Nerd Font";
    font-weight: bold;
    font-size: 16px;
}

/* Main window */
window {
    width: 320px;
    border: 2px;
    border-radius: 0px;
    border-color: @active;
    background-color: @bg;
}

/* Input bar */
inputbar {
    padding: 10px;
    spacing: 8px;
    background-color: @bg-alt;
    border-radius: 0px;
}

prompt {
    text-color: #b8b4d0;
}

entry {
    text-color: @fg;
    placeholder: "Search…";
    placeholder-color: @fg-alt;
}

/* List */
listview {
    lines: 8;
    spacing: 4px;
    padding: 6px;
    background-color: transparent;
}

/* Elements */
element {
    padding: 6px;
    border-radius: 0px;
}

element normal.normal {
    text-color: @fg;
}

element selected.normal {
    background-color: @selected-bg;
    text-color: #d8d5e3;
}

element alternate.normal {
    background-color: transparent;
}

/* Icons */
element-icon {
    size: 28px;
    margin: 0 8px 0 0;
}
