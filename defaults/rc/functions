mkcd() {
  mkdir -p "$1" && cd "$1"
}

sys() {
  sudo systemctl $1 $2
}

extract() {
  case "$1" in
    *.tar.bz2) tar xjf "$1" ;;
    *.tar.gz|*.tgz) tar xzf "$1" ;;
    *.tbz2) tar xjf "$1" ;;
    *.tar) tar xf "$1" ;;
    *.zip) unzip "$1" ;;
    *.7z) 7z x "$1" ;;
    *.rar) unrar x "$1" ;;
    *.gz) gunzip "$1" ;;
    *.bz2) bunzip2 "$1" ;;
    *) echo "Unsupported archive: $1" ;;
  esac
}

# bash history with fzf
fzf_history() {
  local cmd
  cmd=$(history | tac | awk '{
      s=$0; sub(/^[[:space:]]*[0-9]+[[:space:]]+/, "", s);
      if (!seen[s]++) print $0
    }' | fzf --tiebreak=index --query="$READLINE_LINE" --height=50% --layout=reverse | \
    sed 's/^[[:space:]]*[0-9]\+[[:space:]]*//')

  if [ -n "$cmd" ]; then
    READLINE_LINE="$cmd"
    READLINE_POINT=${#READLINE_LINE}
  fi
}


bind -x '"\C-r": fzf_history'
